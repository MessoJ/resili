# Never commit actual credentials. Copy this file to .env for local development.
NODE_ENV=development
DATABASE_URL=postgresql://resili:resili@localhost:5432/resili
REDIS_URL=redis://localhost:6379

# Africa's Talking (SMS + USSD)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER=

# Safaricom Daraja. Obtain remaining values from the sandbox portal.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_BUSINESS_SHORT_CODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_B2C_RESULT_URL=
DARAJA_QUEUE_TIMEOUT_URL=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# Application signing and payment adapter.
# PAYOUT_ADAPTER=mock -> deterministic offline stubs (default, demo-safe).
# PAYOUT_ADAPTER=live -> real Daraja B2C + Africa's Talking SMS (needs creds).
ALERT_SIGNING_PRIVATE_KEY=
PAYOUT_ADAPTER=mock

# Heroku deployment (see docs/DEPLOY-HEROKU.md).
# Used by the Heroku CLI, scripts/heroku-setup.sh, and the GitHub Actions
# deploy pipeline. In CI, store this as the repo secret HEROKU_API_KEY instead
# of committing it. Generate with: heroku authorizations:create
HEROKU_API_KEY=
# Public Mapbox "pk." token — inlined into the console at build time. Safe to
# ship to the browser; restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
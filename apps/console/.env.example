# resili Console — environment template.
# Copy to .env.local and fill in real values:  cp .env.example .env.local

# Mapbox GL access token (https://account.mapbox.com/access-tokens/).
# Required for the interactive ward risk map to render its basemap.
# A public "pk." token is safe to ship to the browser; restrict it by
# URL in the Mapbox dashboard before production.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Base URL of the Go API gateway (services/gateway) that proxies live
# ward risk from the Python ML service (services/forecast-ingest).
# Leave as-is for local development. The console degrades gracefully to
# deterministic demo data when this endpoint is unreachable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
